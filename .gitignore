logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===============================
# ENV (SECRET - NEVER COMMIT)
# ===============================
.env
.env.*
server/.env
client/.env

# ===============================
# KEEP ENV TEMPLATE (SAFE)
# ===============================
!.env.example
!server/.env.example
!client/.env.production
!client/.env.production.example

